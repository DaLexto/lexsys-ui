{
  "name": "lexsys-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "A registry-first React UI framework that generates copyable components directly into your project, powered by Base UI, Tailwind CSS, and a full design token system.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint:root && turbo run check",
    "dev": "turbo run dev",
    "docs:build": "turbo run build --filter=@dalexto/lexsys-docs",
    "docs:dev": "turbo run dev --filter=@dalexto/lexsys-docs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:fix": "pnpm lint:root:fix && turbo run lint:fix",
    "lint:root": "eslint *.config.mjs --max-warnings=0",
    "lint:root:fix": "eslint *.config.mjs --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "scripts:check": "node scripts/validate-root-scripts.mjs",
    "sync:all": "pnpm registry:sync && pnpm tokens:generate:styles",
    "sync:styles": "pnpm tokens:generate:styles",
    "sync:templates": "pnpm registry:sync",
    "tokens:build": "turbo run build --filter=@dalexto/lexsys-tokens",
    "tokens:check": "turbo run check --filter=@dalexto/lexsys-tokens",
    "tokens:generate:styles": "pnpm --filter @dalexto/lexsys-tokens run generate:styles",
    "tokens:governance:report": "pnpm --filter @dalexto/lexsys-tokens run governance:report",
    "tokens:imports:clean": "pnpm --filter @dalexto/lexsys-tokens run imports:clean",
    "tokens:lint": "turbo run lint --filter=@dalexto/lexsys-tokens",
    "tokens:lint:fix": "turbo run lint:fix --filter=@dalexto/lexsys-tokens",
    "tokens:re-prefix": "node scripts/rebrand/rename-prefix.mjs",
    "tokens:test": "turbo run test --filter=@dalexto/lexsys-tokens",
    "tokens:typecheck": "turbo run typecheck --filter=@dalexto/lexsys-tokens",
    "ui:audit": "pnpm --filter @dalexto/lexsys-ui run audit",
    "ui:audit:catalog:check": "pnpm --filter @dalexto/lexsys-ui run audit:catalog:check",
    "ui:audit:catalog:write": "pnpm --filter @dalexto/lexsys-ui run audit:catalog:write",
    "ui:build": "turbo run build --filter=@dalexto/lexsys-ui",
    "ui:check": "turbo run check --filter=@dalexto/lexsys-ui",
    "ui:lint": "turbo run lint --filter=@dalexto/lexsys-ui",
    "ui:lint:fix": "turbo run lint:fix --filter=@dalexto/lexsys-ui",
    "ui:test": "turbo run test --filter=@dalexto/lexsys-ui",
    "ui:typecheck": "turbo run typecheck --filter=@dalexto/lexsys-ui",
    "registry:build": "turbo run build --filter=@dalexto/lexsys-registry",
    "registry:check": "turbo run check --filter=@dalexto/lexsys-registry",
    "registry:lint": "turbo run lint --filter=@dalexto/lexsys-registry",
    "registry:lint:fix": "turbo run lint:fix --filter=@dalexto/lexsys-registry",
    "registry:styles:check-sync": "pnpm --filter @dalexto/lexsys-registry run styles:check-sync",
    "registry:styles:sync": "pnpm --filter @dalexto/lexsys-registry run styles:sync",
    "registry:sync": "pnpm --filter @dalexto/lexsys-registry run templates:sync",
    "registry:templates:check-sync": "pnpm --filter @dalexto/lexsys-registry run templates:check-sync",
    "registry:test": "turbo run test --filter=@dalexto/lexsys-registry",
    "registry:typecheck": "turbo run typecheck --filter=@dalexto/lexsys-registry",
    "cli:build": "turbo run build --filter=@dalexto/lexsys-cli",
    "cli:check": "turbo run check --filter=@dalexto/lexsys-cli",
    "cli:lint": "turbo run lint --filter=@dalexto/lexsys-cli",
    "cli:lint:fix": "turbo run lint:fix --filter=@dalexto/lexsys-cli",
    "cli:test": "turbo run test --filter=@dalexto/lexsys-cli",
    "cli:typecheck": "turbo run typecheck --filter=@dalexto/lexsys-cli",
    "entry:check": "node packages/entry/bin.js --version",
    "publish:pack-audit": "node scripts/publish/pack-audit.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "publish:release": "pnpm --filter @dalexto/lexsys-registry build && pnpm --filter @dalexto/lexsys-cli build && changeset publish --no-git-tag --tag next",
    "publish:release:latest": "pnpm --filter @dalexto/lexsys-registry build && pnpm --filter @dalexto/lexsys-cli build && changeset publish --no-git-tag --tag latest",
    "publish:pack-entry": "cd packages/entry && pnpm pack --pack-destination ../../.tmp",
    "playground:build": "pnpm tokens:build && pnpm ui:build && turbo run build --filter=@dalexto/lexsys-playground",
    "playground:check": "turbo run check --filter=@dalexto/lexsys-playground",
    "playground:dev": "turbo run dev --filter=@dalexto/lexsys-playground",
    "playground:lint": "turbo run lint --filter=@dalexto/lexsys-playground",
    "playground:lint:fix": "turbo run lint:fix --filter=@dalexto/lexsys-playground",
    "playground:preview": "pnpm --filter @dalexto/lexsys-playground run preview",
    "playground:typecheck": "pnpm tokens:build && pnpm ui:build && turbo run typecheck --filter=@dalexto/lexsys-playground"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^25.9.2",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "typescript",
    "tailwindcss"
  ],
  "author": "DaLexto",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
